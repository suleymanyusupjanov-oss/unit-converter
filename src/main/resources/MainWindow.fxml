<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="ui.MainController" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <SplitPane dividerPositions="0.4" prefHeight="160.0" prefWidth="200.0">
            <items>
                <VBox spacing="10.0">
                    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Единицы измерения (Master)" />
                    <TableView fx:id="unitsTableView" VBox.vgrow="ALWAYS">
                        <placeholder><Label text="Нет единиц измерения"/></placeholder>
                    </TableView>
                </VBox>
                <VBox spacing="10.0">
                    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                    <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Правила конвертации (Detail)" />
                    <TableView fx:id="rulesTableView" VBox.vgrow="ALWAYS">
                        <placeholder><Label text="Выберите единицу слева, чтобы увидеть правила"/></placeholder>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f0f0f0;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            <Button fx:id="convertButton" text="Конвертировать значение" />
            <Button fx:id="addUnitButton" text="Добавить единицу" />
            <Button fx:id="addRuleButton" text="Добавить правило" />

            <HBox HBox.hgrow="ALWAYS" />

            <Button fx:id="refreshButton" style="-fx-font-weight: bold;" text="🔄 Обновить из БД" />
        </HBox>
    </bottom>
</BorderPane>